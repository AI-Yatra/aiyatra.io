---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { NEW_POST_URL, EDITOR_URL, CONTACT_EMAIL } from '../lib/site';

const steps = [
	{
		icon: 'Github',
		tone: 'bg-tone-blue',
		title: 'Sign in with GitHub',
		body: 'Open the editor and sign in with a free GitHub account. Your draft is saved to your own copy of the site, so nothing goes live until it has been reviewed.',
	},
	{
		icon: 'PenLine',
		tone: 'bg-tone-violet',
		title: 'Write in the visual editor',
		body: 'Rich text, headings, code blocks, images and links. A side-by-side preview shows your post in the same style it will have on aiyatra.io.',
	},
	{
		icon: 'Send',
		tone: 'bg-tone-yellow',
		title: 'Submit for review',
		body: 'When you are happy with it, set the status to “In review”. This sends your post to the AIYatra team as a pull request.',
	},
	{
		icon: 'MessageSquareText',
		tone: 'bg-tone-coral',
		title: 'Get feedback, revise',
		body: 'Reviewers leave comments on your pull request and GitHub emails you. Reopen your post in the editor, make the changes and save, and the review updates by itself.',
	},
	{
		icon: 'CircleCheck',
		tone: 'bg-tone-green',
		title: 'Approved and published',
		body: 'Once it is approved, the team publishes it and it appears here on the blog a few minutes later, with your name and links.',
	},
] as const;

const guidelines = [
	'Original writing: a project you built, a paper you broke down, a lesson from a session, a tutorial.',
	'Hands-on is good: code, numbers, diagrams and what went wrong are all welcome.',
	'Aim for roughly 800–2,500 words. Clear beats long.',
	'Use only images you made or have the right to share, and credit your sources.',
	'Nothing promotional. Mentioning your own work is fine when it helps the reader.',
	'Be kind and inclusive. The AIYatra community is open to everyone.',
];

const faqs = [
	{
		q: 'Do I need a GitHub account?',
		a: 'Yes. A free account is all it takes. It is how we keep track of your draft, the review comments and the changes you make.',
	},
	{
		q: 'Can I write in Markdown or paste from Google Docs?',
		a: 'Both work. The editor has a rich-text mode and a Markdown mode, and pasted content keeps headings, lists and links.',
	},
	{
		q: 'How long does a review take?',
		a: 'Usually within a week. If you have not heard back, reply on your pull request or email us.',
	},
	{
		q: 'Can I edit a post after it is published?',
		a: 'Yes. Open it in the editor and submit the change. It goes through the same quick review.',
	},
];
---
<BaseLayout
	title="Write for AIYatra — Blog"
	description="Anyone can write a guest post for the AIYatra blog. Draft it in our visual editor, submit it for review, act on feedback, and see it published on aiyatra.io."
>
	<section id="top" class="relative overflow-hidden">
		<div class="wrap pb-12 pt-14 lg:pb-16 lg:pt-[74px]">
			<div data-reveal class="flex flex-wrap items-center gap-3">
				<a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-bold underline underline-offset-4 hover:text-tone-blue-deep">
					<Icon name="ArrowLeft" class="h-4 w-4" /> Back to the blog
				</a>
			</div>
			<div data-reveal style="--reveal-delay:0.04s">
				<span class="mt-6 inline-flex items-center gap-2 rounded-full border-2 border-ink bg-tone-yellow px-4 py-1.5 text-sm font-semibold shadow-paper-sm">
					<Icon name="PenLine" class="h-4 w-4" /> Write for AIYatra
				</span>
			</div>
			<div data-reveal style="--reveal-delay:0.08s">
				<h1 class="mt-6 max-w-4xl font-hand text-6xl font-bold leading-[0.95] tracking-tight sm:text-7xl">
					Your story,<br />on our <span class="text-tone-blue-deep underline decoration-tone-coral decoration-4 underline-offset-8">blog.</span>
				</h1>
			</div>
			<div data-reveal style="--reveal-delay:0.16s">
				<p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
					Built something, broke down a paper, or learned something worth passing on? Anyone in the
					community can submit a guest post. You write it, we review it with you, and it goes live on aiyatra.io.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-3">
					<a href={NEW_POST_URL} class="active-press inline-flex h-12 items-center gap-2 rounded-xl border-2 border-ink bg-tone-blue-deep px-6 text-base font-semibold text-paper shadow-paper transition-transform hover:-translate-y-0.5">
						<Icon name="PenLine" class="h-5 w-5" /> Start writing
					</a>
					<a href={EDITOR_URL} class="active-press inline-flex h-12 items-center gap-2 rounded-xl border-2 border-ink bg-paper px-6 text-base font-semibold shadow-paper-sm transition-transform hover:-translate-y-0.5">
						<Icon name="FolderOpen" class="h-5 w-5" /> My drafts
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="border-t-2 border-ink bg-tone-blue/30">
		<div class="wrap py-16">
			<div data-reveal>
				<p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.25em] text-tone-blue-deep"><Icon name="Route" class="h-4 w-4" /> How it works</p>
				<h2 class="mt-3 font-hand text-4xl font-bold leading-tight sm:text-5xl">From draft to published, in five steps.</h2>
			</div>
			<ol class="mt-10 grid items-stretch gap-6 md:grid-cols-2 lg:grid-cols-5">
				{steps.map((s, i) => (
					<li class="h-full" data-reveal style={`--reveal-delay:${Math.min(i * 0.06, 0.25)}s`}>
						<div class="flex h-full flex-col rounded-2xl border-2 border-ink bg-paper-soft p-6 shadow-paper-sm">
							<div class="flex items-center justify-between">
								<span class={`inline-flex h-12 w-12 items-center justify-center rounded-xl border-2 border-ink ${s.tone}`}>
									<Icon name={s.icon} class="h-5 w-5" />
								</span>
								<span class="font-hand text-4xl font-bold text-ink/15">0{i + 1}</span>
							</div>
							<h3 class="mt-5 font-hand text-2xl font-bold leading-tight">{s.title}</h3>
							<p class="mt-2 text-sm font-medium leading-relaxed text-ink/75">{s.body}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="border-t-2 border-ink bg-paper-soft">
		<div class="wrap grid gap-10 py-16 lg:grid-cols-2">
			<div data-reveal>
				<p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.25em] text-tone-blue-deep"><Icon name="ListChecks" class="h-4 w-4" /> Guidelines</p>
				<h2 class="mt-3 font-hand text-4xl font-bold leading-tight sm:text-5xl">What makes a great post.</h2>
				<ul class="mt-8 space-y-3">
					{guidelines.map((g) => (
						<li class="flex items-start gap-3 rounded-xl border-2 border-ink bg-paper p-4 text-sm font-medium leading-relaxed text-ink/80">
							<Icon name="Check" class="mt-0.5 h-4 w-4 shrink-0 text-tone-blue-deep" /> {g}
						</li>
					))}
				</ul>
			</div>
			<div data-reveal style="--reveal-delay:0.08s">
				<p class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.25em] text-tone-blue-deep"><Icon name="CircleHelp" class="h-4 w-4" /> Quick answers</p>
				<h2 class="mt-3 font-hand text-4xl font-bold leading-tight sm:text-5xl">Before you start.</h2>
				<div class="mt-8 space-y-3">
					{faqs.map((f) => (
						<details class="group rounded-xl border-2 border-ink bg-paper p-4 [&_summary::-webkit-details-marker]:hidden">
							<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
								{f.q}
								<Icon name="Plus" class="h-4 w-4 shrink-0 transition-transform group-open:rotate-45" />
							</summary>
							<p class="mt-3 text-sm leading-relaxed text-ink/75">{f.a}</p>
						</details>
					))}
				</div>
			</div>
		</div>
	</section>

	<section class="border-t-2 border-ink bg-tone-blue/30">
		<div class="wrap py-16">
			<div data-reveal>
				<div class="grid gap-6 rounded-2xl border-2 border-ink bg-ink p-8 text-white shadow-paper sm:p-10 lg:grid-cols-[1.4fr_1fr] lg:items-center">
					<div>
						<p class="font-hand text-4xl font-bold leading-tight sm:text-5xl">Ready when you are.</p>
						<p class="mt-3 max-w-xl text-sm leading-relaxed text-white/70">
							Questions before you begin? Write to <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-white underline underline-offset-4">{CONTACT_EMAIL}</a>.
						</p>
					</div>
					<div class="flex flex-wrap gap-3 lg:justify-end">
						<a href={NEW_POST_URL} class="active-press inline-flex h-12 items-center gap-2 rounded-xl bg-white px-6 text-base font-semibold text-ink transition-transform hover:-translate-y-0.5">
							<Icon name="PenLine" class="h-5 w-5" /> Start writing
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
