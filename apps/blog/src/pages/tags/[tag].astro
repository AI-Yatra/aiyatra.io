---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, collectTags, CARD_TONES, type TagInfo } from '../../lib/posts';

export async function getStaticPaths() {
	return collectTags(await getPosts()).map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}
interface Props { tag: TagInfo }
const { tag } = Astro.props;
const noun = tag.count === 1 ? 'post' : 'posts';
---
<BaseLayout title={`${tag.name} — AIYatra Blog`} description={`${tag.count} ${noun} about ${tag.name} from the AIYatra community.`}>
	<section class="wrap pb-10 pt-14">
		<a href="/blog/tags" class="inline-flex items-center gap-1.5 text-sm font-bold underline underline-offset-4 hover:text-tone-blue-deep"><Icon name="ArrowLeft" class="h-4 w-4" /> All topics</a>
		<h1 class="mt-5 font-hand text-6xl font-bold leading-[0.95] tracking-tight">{tag.name}</h1>
		<p class="mt-4 text-lg text-ink-soft">{tag.count} {noun}</p>
	</section>
	<section class="border-t-2 border-ink bg-tone-blue/30">
		<div class="wrap grid items-stretch gap-6 py-14 md:grid-cols-2 lg:grid-cols-3">
			{tag.posts.map((post, i) => <div class="h-full"><PostCard post={post} tone={CARD_TONES[i % CARD_TONES.length]} /></div>)}
		</div>
	</section>
</BaseLayout>
