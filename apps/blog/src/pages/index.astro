---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import TagCloud from '../components/TagCloud.astro';
import Icon from '../components/Icon.astro';
import { PAST_EVENTS_URL, MEETUP_URL, WHATSAPP_URL } from '../lib/site';
import { getPosts, collectTags, type Post } from '../lib/posts';
import { CATEGORIES } from '../content.config';

const posts = await getPosts();
const tags = collectTags(posts);
const categories = CATEGORIES.filter((c) => posts.some((p) => p.data.category === c));

// Newest first, in one group per month.
const monthName = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const months: { label: string; posts: Post[] }[] = [];
for (const post of posts) {
	const label = monthName.format(post.data.date);
	const last = months[months.length - 1];
	if (last?.label === label) last.posts.push(post);
	else months.push({ label, posts: [post] });
}

const explore = [
	{ href: '/blog/paths', label: 'Learning paths', note: 'Guided reading orders', icon: 'Route' },
	{ href: '/blog/map', label: 'Knowledge map', note: 'How topics connect', icon: 'Share2' },
	{ href: '/blog/authors', label: 'Contributors', note: 'The people who write here', icon: 'Users' },
	{ href: PAST_EVENTS_URL, label: 'Session archive', note: 'Photos and RSVPs on Meetup', icon: 'CalendarDays', external: true },
] as const;
const follow = [
	{ href: MEETUP_URL, label: 'Meetup', icon: 'CalendarDays', external: true },
	{ href: WHATSAPP_URL, label: 'WhatsApp', icon: 'WhatsApp', external: true },
	{ href: '/blog/rss.xml', label: 'RSS', icon: 'Rss' },
] as const;
---
<BaseLayout
	title="Blog — AIYatra"
	description="Session recaps, tutorials and guest posts from the AIYatra community — PyTorch, transformers, DeepSeek-V3, agentic AI and more. Written from the room, free forever."
>
	<div class="wrap blog-home">
		<header class="blog-masthead">
			<h1 class="font-hand text-5xl font-bold leading-none tracking-tight sm:text-6xl">The AIYatra Blog</h1>
			<p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-soft">Session recaps, tutorials and guest posts from our open-source AI community.</p>
		</header>

		<div class="blog-columns">
			<section aria-label="All posts" class="min-w-0">
				{categories.length > 1 && (
					<div class="blog-filter" role="group" aria-label="Filter posts by category">
						<button type="button" data-filter="all" aria-pressed="true">All <span>{posts.length}</span></button>
						{categories.map((c) => (
							<button type="button" data-filter={c} aria-pressed="false">{c} <span>{posts.filter((p) => p.data.category === c).length}</span></button>
						))}
					</div>
				)}
				{months.map((m) => (
					<section class="blog-month" data-month>
						<h2>{m.label}</h2>
						{m.posts.map((post) => <PostRow post={post} />)}
					</section>
				))}
			</section>

			<aside class="blog-sidebar" aria-label="Explore the blog">
				<button type="button" data-open-search class="blog-search">
					<Icon name="Search" class="h-4 w-4" /> <span>Search posts…</span> <kbd>⌘K</kbd>
				</button>

				<section>
					<div class="blog-side-head">
						<h2>Topics</h2>
						<a href="/blog/tags">All {tags.length}</a>
					</div>
					<TagCloud tags={tags.filter((t) => t.count > 1)} compact />
				</section>

				<section>
					<h2>Explore</h2>
					<ul class="blog-side-links">
						{explore.map((l) => (
							<li>
								<a href={l.href} {...('external' in l ? { target: '_blank', rel: 'noreferrer' } : {})}>
									<Icon name={l.icon} class="h-4 w-4 shrink-0" />
									<span><strong>{l.label}</strong><small>{l.note}</small></span>
								</a>
							</li>
						))}
					</ul>
				</section>

				<section>
					<h2>Write for us</h2>
					<p>Built or learned something? Anyone can submit a guest post, and it goes live once reviewed.</p>
					<a href="/blog/write" class="blog-side-cta"><Icon name="PenLine" class="h-4 w-4" /> Write a guest post</a>
				</section>

				<section>
					<h2>Follow along</h2>
					<ul class="blog-side-follow">
						{follow.map((l) => (
							<li><a href={l.href} {...('external' in l ? { target: '_blank', rel: 'noreferrer' } : {})}><Icon name={l.icon} class="h-4 w-4" /> {l.label}</a></li>
						))}
					</ul>
				</section>
			</aside>
		</div>
	</div>
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
	const months = document.querySelectorAll<HTMLElement>('[data-month]');
	buttons.forEach((button) => button.addEventListener('click', () => {
		const filter = button.dataset.filter;
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
		months.forEach((month) => {
			let shown = 0;
			month.querySelectorAll<HTMLElement>('[data-category]').forEach((row) => {
				const match = filter === 'all' || row.dataset.category === filter;
				row.hidden = !match;
				if (match) shown++;
			});
			month.hidden = shown === 0;
		});
	}));
</script>
