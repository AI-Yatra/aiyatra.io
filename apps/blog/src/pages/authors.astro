---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getPosts, collectAuthors, initials } from '../lib/posts';

const authors = collectAuthors(await getPosts());
---
<BaseLayout title="Contributors — AIYatra Blog" description="The people who write for the AIYatra blog: community members, guest authors and the AIYatra team.">
	<section class="wrap pb-10 pt-14">
		<h1 class="font-hand text-6xl font-bold leading-[0.95] tracking-tight">Contributors</h1>
		<p class="mt-4 max-w-xl text-lg text-ink-soft">The people behind every post. Anyone can join them.</p>
		<a href="/blog/write" class="active-press mt-6 inline-flex h-12 items-center gap-2 rounded-xl border-2 border-ink bg-tone-blue-deep px-6 text-base font-semibold text-paper shadow-paper transition-transform hover:-translate-y-0.5"><Icon name="PenLine" class="h-5 w-5" /> Write a guest post</a>
	</section>
	<section class="border-t-2 border-ink bg-tone-blue/30">
		<ul class="wrap grid items-stretch gap-6 py-14 md:grid-cols-2 lg:grid-cols-3">
			{authors.map((a) => (
				<li>
					<a href={`/blog/authors/${a.slug}`} class="hover-lift flex h-full flex-col rounded-2xl border-2 border-ink bg-paper p-6 shadow-paper-sm">
						<span class="flex items-center gap-4">
							{a.avatar ? <img src={a.avatar} alt="" width="64" height="64" loading="lazy" class="h-16 w-16 shrink-0 rounded-full border-2 border-ink object-cover" /> : <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-2 border-ink bg-tone-blue font-display text-xl font-bold text-tone-blue-deep">{initials(a.name)}</span>}
							<span class="min-w-0">
								<span class="block font-hand text-2xl font-bold leading-tight">{a.name}</span>
								<span class="text-sm font-semibold text-ink/70">{a.posts.length} {a.posts.length === 1 ? 'post' : 'posts'}</span>
							</span>
						</span>
						{a.topics.length > 0 && <span class="mt-4 block text-sm font-medium text-ink/75">Writes about {a.topics.join(', ')}</span>}
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>
