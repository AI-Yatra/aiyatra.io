---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, collectAuthors, initials, type AuthorInfo } from '../../lib/posts';

export async function getStaticPaths() {
	return collectAuthors(await getPosts()).map((author) => ({ params: { author: author.slug }, props: { author } }));
}
interface Props { author: AuthorInfo }
const { author } = Astro.props;
const noun = author.posts.length === 1 ? 'post' : 'posts';
---
<BaseLayout title={`${author.name} — AIYatra Blog`} description={`${author.posts.length} ${noun} by ${author.name} on the AIYatra blog.`}>
	<section class="wrap pb-10 pt-14">
		<a href="/blog/authors" class="inline-flex items-center gap-1.5 text-sm font-bold underline underline-offset-4 hover:text-tone-blue-deep"><Icon name="ArrowLeft" class="h-4 w-4" /> All contributors</a>
		<div class="mt-6 flex flex-wrap items-center gap-6">
			{author.avatar ? <img src={author.avatar} alt="" width="96" height="96" class="h-24 w-24 rounded-full border-2 border-ink object-cover" /> : <span class="flex h-24 w-24 items-center justify-center rounded-full border-2 border-ink bg-tone-blue font-display text-3xl font-bold text-tone-blue-deep">{initials(author.name)}</span>}
			<div class="min-w-0 flex-1">
				<h1 class="font-hand text-5xl font-bold leading-[0.95] tracking-tight sm:text-6xl">{author.name}</h1>
				{author.role && <p class="mt-3 max-w-2xl text-base font-medium text-ink/75">{author.role}</p>}
				<p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-bold">
					<span>{author.posts.length} {noun}</span>
					{author.url && <a href={author.url} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1 underline underline-offset-4 hover:text-tone-blue-deep">Website <Icon name="ArrowUpRight" class="h-4 w-4" /></a>}
				</p>
			</div>
		</div>
	</section>
	<section class="wrap pb-16">
		<div class="post-list">
			{author.posts.map((post) => <PostRow post={post} />)}
		</div>
	</section>
</BaseLayout>
