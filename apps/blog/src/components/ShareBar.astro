---
import Icon from './Icon.astro';
import { SITE_URL } from '../lib/site';

interface Props { title: string; slug: string; labelled?: boolean }
const { title, slug, labelled } = Astro.props;
const url = `${SITE_URL}/blog/${slug}`;
const q = encodeURIComponent;
const button = 'inline-flex h-10 min-w-10 items-center justify-center gap-1.5 rounded-xl border-2 border-ink bg-paper px-2.5 text-sm font-bold shadow-paper-sm transition-transform hover:-translate-y-0.5 hover:text-tone-blue-deep';
---
<div class="flex flex-wrap items-center gap-2" role="group" aria-label="Share this post" data-pagefind-ignore>
	{labelled && <span class="mr-1 font-hand text-2xl font-bold leading-tight">Share this post</span>}
	<a class={button} href={`https://www.linkedin.com/sharing/share-offsite/?url=${q(url)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn" title="Share on LinkedIn"><Icon name="Linkedin" class="h-4 w-4" /></a>
	<a class={button} href={`https://x.com/intent/post?url=${q(url)}&text=${q(title)}`} target="_blank" rel="noopener" aria-label="Share on X" title="Share on X"><span aria-hidden="true" class="px-0.5">𝕏</span></a>
	<a class={button} href={`https://wa.me/?text=${q(`${title} ${url}`)}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp" title="Share on WhatsApp"><Icon name="WhatsApp" class="h-4 w-4" /></a>
	<button type="button" class={button} data-copy-link={url} aria-label="Copy link" title="Copy link"><Icon name="Link" class="h-4 w-4" /> <span data-copy-label class="hidden">Copied</span></button>
</div>
