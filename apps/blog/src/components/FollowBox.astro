---
// Shows the newsletter form once a provider is set in lib/site.ts. Until then it
// offers the ways readers can already follow along.
import Icon from './Icon.astro';
import { NEWSLETTER_FORM_ACTION, NEWSLETTER_EMAIL_FIELD, MEETUP_URL, WHATSAPP_URL } from '../lib/site';
const link = 'inline-flex h-11 items-center gap-2 rounded-xl border-2 border-ink bg-paper px-4 text-sm font-bold shadow-paper-sm transition-transform hover:-translate-y-0.5';
---
<aside class="grid gap-4 rounded-2xl border-2 border-ink bg-tone-yellow/50 p-6 shadow-paper-sm lg:grid-cols-[1.2fr_1fr] lg:items-center" aria-label="Follow AIYatra" data-pagefind-ignore>
	<div>
		<p class="font-hand text-3xl font-bold leading-tight">Don’t miss the next one.</p>
		<p class="mt-1 text-sm font-medium text-ink/75">New posts and session recaps from the AIYatra community.</p>
	</div>
	{NEWSLETTER_FORM_ACTION ? (
		<form action={NEWSLETTER_FORM_ACTION} method="post" target="_blank" class="flex flex-wrap gap-2 lg:justify-end">
			<label class="sr-only" for="newsletter-email">Email address</label>
			<input id="newsletter-email" name={NEWSLETTER_EMAIL_FIELD} type="email" required autocomplete="email" placeholder="you@example.com" class="h-11 min-w-0 flex-1 rounded-xl border-2 border-ink bg-paper px-3 text-sm" />
			<button class="h-11 rounded-xl border-2 border-ink bg-tone-blue-deep px-5 text-sm font-bold text-white">Subscribe</button>
		</form>
	) : (
		<div class="flex flex-wrap gap-2 lg:justify-end">
			<a class={link} href={MEETUP_URL} target="_blank" rel="noreferrer"><Icon name="CalendarDays" class="h-4 w-4" /> Meetup</a>
			<a class={link} href={WHATSAPP_URL} target="_blank" rel="noreferrer"><Icon name="WhatsApp" class="h-4 w-4" /> WhatsApp</a>
			<a class={link} href="/blog/rss.xml"><Icon name="Rss" class="h-4 w-4" /> RSS</a>
		</div>
	)}
</aside>
