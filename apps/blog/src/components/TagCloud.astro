---
// Tags drift gently, sized by how many posts use them. Hovering or focusing the
// cloud pauses it so links are easy to hit, and it stays still for anyone who
// has asked for reduced motion. It's all CSS, so it works without JavaScript.
import type { TagInfo } from '../lib/posts';

interface Props { tags: TagInfo[]; limit?: number }
const { tags, limit } = Astro.props;
const shown = limit ? tags.slice(0, limit) : tags;
const most = Math.max(1, ...shown.map((t) => t.count));

// Mixed by name, not popularity, so big and small tags sit side by side. The
// same name always gets the same place and motion, so the page doesn't reshuffle.
const hash = (s: string) => [...s].reduce((h, c) => (Math.imul(h, 31) + c.charCodeAt(0)) >>> 0, 7);
const mixed = [...shown].sort((a, b) => hash(a.slug) - hash(b.slug));

function style(t: TagInfo) {
	const h = hash(t.slug);
	const weight = most === 1 ? 0 : (t.count - 1) / (most - 1);
	return [
		`--size:${(0.95 + weight * 1.45).toFixed(2)}rem`,
		`--weight:${weight > 0.4 ? 700 : 600}`,
		`--dx:${3 + (h % 9)}px`,
		`--dy:${2 + ((h >> 4) % 7)}px`,
		`--dur:${(5 + ((h >> 8) % 60) / 10).toFixed(1)}s`,
		`--delay:-${((h >> 12) % 50) / 10}s`,
	].join(';');
}
---
<ul class="tag-cloud" aria-label="Browse posts by topic">
	{mixed.map((t) => (
		<li class={t.count === 1 && most > 1 ? 'is-minor' : undefined}>
			<a href={`/blog/tags/${t.slug}`} style={style(t)} aria-label={`${t.name}: ${t.count} ${t.count === 1 ? 'post' : 'posts'}`}>{t.name}{t.count > 1 && <sup aria-hidden="true">{t.count}</sup>}</a>
		</li>
	))}
</ul>
