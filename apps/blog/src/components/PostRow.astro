---
// One post in a list: a date, a title and a summary, colour-coded by category.
import Icon from './Icon.astro';
import { isoDate, readingTime, toSlug, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const { title, excerpt, date, author, attendees, tags, category } = post.data;
const href = `/blog/${post.id}`;
const day = new Intl.DateTimeFormat('en-US', { day: '2-digit', timeZone: 'UTC' }).format(date);
const month = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' }).format(date);
const year = date.getUTCFullYear();
---
<article class="post-row" data-category={category}>
	<time class="post-row-date" datetime={isoDate(date)}>
		<strong>{day}</strong>
		<span>{month}</span>
		<span class="post-row-year">{year}</span>
	</time>
	<div class="post-row-body">
		<p class="post-row-kicker"><span class="cat-pill">{category}</span></p>
		<h3 class="post-row-title"><a href={href}>{title}</a></h3>
		<p class="post-row-excerpt">{excerpt}</p>
		<p class="post-row-meta">
			<span>{author}</span>
			<span aria-hidden="true">·</span>
			<span>{readingTime(post.body)} min read</span>
			{attendees ? <><span aria-hidden="true">·</span><span>{attendees} attended</span></> : null}
		</p>
		{tags.length > 0 && (
			<ul class="post-row-tags" aria-label="Topics">
				{tags.slice(0, 4).map((t) => <li><a href={`/blog/tags/${toSlug(t)}`}>#{t}</a></li>)}
			</ul>
		)}
	</div>
	<span class="post-row-arrow" aria-hidden="true"><Icon name="ArrowUpRight" class="h-6 w-6" /></span>
</article>
