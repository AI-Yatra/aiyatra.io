---
import Icon from './Icon.astro';
import { photoProps } from '../lib/site';
import { formatDate, readingTime, toSlug, type Post } from '../lib/posts';

interface Props { post: Post; tone: string }
const { post, tone } = Astro.props;
const { title, excerpt, cover, category, date, attendees, author, tags } = post.data;
const href = `/blog/${post.id}`;
const isRecap = category === 'Session recap';
---
<article class="hover-lift flex h-full flex-col overflow-hidden rounded-2xl border-2 border-ink bg-paper-soft shadow-paper-sm">
	<a href={href} class="relative block aspect-[16/9] overflow-hidden border-b-2 border-ink bg-tone-blue/30" tabindex="-1" aria-hidden="true">
		{cover ? (
			<img {...photoProps(cover)} alt="" loading="lazy" decoding="async" width="676" height="380" class="h-full w-full object-cover" />
		) : (
			<div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-tone-blue via-paper-soft to-tone-violet">
				<span class="font-hand text-5xl font-bold text-tone-blue-deep/70">AI Yatra</span>
			</div>
		)}
		<span class={`absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full border-2 border-ink ${tone} px-3 py-1 text-[11px] font-bold uppercase tracking-wide`}>
			<Icon name={isRecap ? 'BookOpen' : category === 'Guest post' ? 'PenLine' : 'Sparkles'} class="h-3.5 w-3.5" /> {isRecap ? 'Story' : category}
		</span>
	</a>
	<div class="flex flex-1 flex-col p-6">
		<h3 class="font-hand text-3xl font-bold leading-tight">
			<a href={href} class="transition-colors hover:text-tone-blue-deep">{title}</a>
		</h3>
		<p class="mt-2 flex-1 text-sm font-medium leading-relaxed text-ink/75">{excerpt}</p>
		{tags.length > 0 && (
			<ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Topics">
				{tags.slice(0, 3).map((t) => <li><a href={`/blog/tags/${toSlug(t)}`} class="relative z-[1] inline-block rounded-full border border-tone-blue-deep/20 bg-tone-blue/50 px-2.5 py-0.5 text-xs font-semibold text-ink/80 transition-colors hover:border-tone-blue-deep hover:text-tone-blue-deep">#{t}</a></li>)}
			</ul>
		)}
		<div class="mt-5 space-y-1.5 border-t-2 border-dashed border-ink/30 pt-4 text-sm font-semibold">
			<p class="inline-flex items-center gap-1.5"><Icon name="CalendarDays" class="h-4 w-4" /> {formatDate(date)}</p>
			{attendees ? (
				<p class="flex items-center gap-1.5"><Icon name="Users" class="h-4 w-4" /> {attendees} attended</p>
			) : (
				<p class="flex items-center gap-1.5"><Icon name="UserRound" class="h-4 w-4" /> {author} · {readingTime(post.body)} min read</p>
			)}
		</div>
		<a href={href} class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold underline underline-offset-4 hover:text-tone-blue-deep">
			{isRecap ? 'Read the recap' : 'Read the post'} <Icon name="ArrowRight" class="h-4 w-4" />
		</a>
	</div>
</article>
