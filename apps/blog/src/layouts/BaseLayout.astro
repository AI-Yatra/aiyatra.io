---
import '../../../web/src/index.css';
import '../styles/blog.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL } from '../lib/site';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	jsonLd?: Record<string, unknown>;
}

const { title, description, image = `${SITE_URL}/og-image.png`, type = 'website', publishedTime, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/', SITE_URL).href;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>document.documentElement.classList.add('js');</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2563eb" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title="AIYatra Blog" href="/blog/rss.xml" />

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="AIYatra" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:locale" content="en_IN" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body>
		<div class="grain min-h-screen bg-paper text-ink antialiased">
			<Header />
			<main id="main">
				<slot />
			</main>
			<Footer />
		</div>
		<script is:inline>
			// Scroll reveal (see styles/blog.css). Inline so content can never
			// stay hidden behind a script that failed to load.
			(function () {
				var els = document.querySelectorAll('[data-reveal]');
				if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('is-in'); }); return; }
				var io = new IntersectionObserver(function (entries) {
					entries.forEach(function (entry) {
						if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
					});
				}, { rootMargin: '0px 0px 150px 0px' });
				els.forEach(function (el) { io.observe(el); });
			})();
		</script>
	</body>
</html>
